{
  "name": "@hanoman/server",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true; prisma generate --schema prisma/schema.prisma",
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --outdir=dist --external:fastify --external:@fastify/static --external:@prisma/client --external:node-pty --external:@fastify/websocket --external:@fastify/cookie --external:pdfkit --external:sharp --banner:js=\"import { createRequire as __hanomanCreateRequire } from 'module'; const require = __hanomanCreateRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@hanoman/runner": "workspace:*",
    "@hanoman/shared": "workspace:*",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.12.1",
    "file-type": "^21.3.4",
    "marked": "^12.0.2",
    "node-pty": "^1.1.0",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.23.0",
    "prisma": "^6.19.0",
    "tsx": "^4.16.0",
    "ws": "^8.21.0"
  }
}
